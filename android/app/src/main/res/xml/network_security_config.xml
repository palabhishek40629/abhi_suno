<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Globally block unencrypted cleartext HTTP traffic to satisfy P0 security audit -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
